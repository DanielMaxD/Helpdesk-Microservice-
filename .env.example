# Copy this file to .env before running `docker compose up`:
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# docker-compose.yml reads every variable below. Anything you don't set
# falls back to a sane local-dev default baked into docker-compose.yml
# EXCEPT JWT_SECRET, which is required on purpose (see note below).

# ---------------------------------------------------------------------------
# Postgres credentials — shared by both the user_db and ticket_db containers.
# Fine as-is for local/demo use.
# ---------------------------------------------------------------------------
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk

# ---------------------------------------------------------------------------
# NOT set here on purpose: DATABASE_URL for either service.
#
# docker-compose.yml sets DATABASE_URL explicitly and directly for both
# user-service and ticket-service, pointing at their internal Docker
# hostnames (user-db:5432 / ticket-db:5432) — this is deliberately NOT
# user-configurable via .env, since it's an internal implementation detail
# of the compose network topology, not something you'd want to point
# somewhere else.
#
# If you instead run a backend service locally (`mvnw spring-boot:run`,
# outside Docker) against these same Postgres containers, DATABASE_URL isn't
# needed there either — each service's application.yml already has a local
# fallback default matching this compose file's HOST port mapping:
#   user_db   -> localhost:5432
#   ticket_db -> localhost:5433 (not 5432 — avoids colliding with user_db)
# See backend/*/README_RUN.md for the full local-run walkthrough.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# JWT signing secret — REQUIRED, no fallback in docker-compose.yml.
#
# user-service issues tokens; ticket-service only validates them. Both
# containers MUST receive the exact same value. This is deliberately not
# defaulted to the "local development only" value baked into each service's
# application.yml, so that starting the full stack forces you to pick your
# own value instead of accidentally shipping the well-known dev default.
#
# Generate a real one with, e.g.:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=replace-this-with-a-long-random-string-before-running-compose

# How long an issued token stays valid, in milliseconds. 86400000 = 24h.
JWT_EXPIRATION_MS=86400000

# ---------------------------------------------------------------------------
# CORS: the origin the browser will be loading the frontend from. Both
# backend services use this to configure allowed-origins.
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend build args — the URLs the BROWSER uses to reach each backend.
#
# These are inlined into the static JS bundle at `docker compose build`
# time (Vite behavior — see frontend/Dockerfile), so they must be the
# services' host-published ports, not their internal Docker hostnames.
# If you change these, you must rebuild the frontend image
# (`docker compose up --build frontend`) — restarting alone won't pick up
# the change.
# ---------------------------------------------------------------------------
VITE_USER_SERVICE_URL=http://localhost:8081
VITE_TICKET_SERVICE_URL=http://localhost:8082
